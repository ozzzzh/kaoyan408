# 依赖与构建产物
node_modules/
client/dist/
# 部署时留下的历史构建备份（dist.old.*、dist.prev.*、dist.replaced-*）同样不入库：
# 只写 client/dist/ 匹配不到它们，实测已经把 1100+ 个构建产物提交进了仓库。
client/dist.*
client/content-bundle/
server/target/
dist/

# 环境与凭据
.env
*.env
!.env.example

# 日志与临时文件
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.iml
*.ipr
*.iws

# 本地测试与覆盖率（按仓库约定不入库）
tests/
__tests__/
coverage/
.nyc_output/

# 编辑器/本地改配色时的临时备份
*.bak-*

# 部署锁是运行期状态，不能入库（实测它被 git add -A 带进过一次）
.deploy.lock
