<?xml version="1.0" encoding="UTF-8"?>
<!--
  Maven 镜像配置。

  为什么需要它：本项目的部署环境（内网服务器）访问 Maven 中央仓库很慢或不通，
  构建时会卡在依赖下载。这里默认指向阿里云公共镜像，国内构建快且稳定。

  为什么放在仓库里而不是每台机器手改：
  服务器上的代码由 git 管理，若这份配置只存在于服务器本地，
  每次 git pull 都会与服务器上的本地修改冲突。把构建所需的配置纳入版本控制，
  才能在「本地开发 → 推送 → 服务器拉取重建」这条链路上保持一致。

  这个文件只在 Docker 构建阶段被复制进构建镜像（见 Dockerfile），
  不影响本机开发：本机若有自己的 ~/.m2/settings.xml，Maven 会用它。
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0
                              https://maven.apache.org/xsd/settings-1.0.0.xsd">
  <mirrors>
    <mirror>
      <id>aliyun-public</id>
      <name>Aliyun Public Mirror</name>
      <url>https://maven.aliyun.com/repository/public</url>
      <mirrorOf>central</mirrorOf>
    </mirror>
  </mirrors>
</settings>