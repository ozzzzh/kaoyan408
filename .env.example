# 复制为 .env 后按需修改；.env 不入库
# 数据库密码（同时作为 MySQL 容器 root 密码与 kaoyan 用户密码）
DB_PASSWORD=change-me-db-password

# JWT 签名密钥，生产环境必须替换为随机长字符串（HS256 要求至少 32 字节）
JWT_SECRET=change-me-jwt-secret-at-least-32-bytes

# 对外访问端口（nginx）。默认 18080，避免与本机开发用的 8080 冲突。
WEB_PORT=18080

# 数据库映射到宿主机的端口，仅用于排查；默认 33061 避开本机 3306
DB_PORT=33061

# 允许跨域访问 API 的来源（浏览器地址）。
# 本地开发用的 localhost / 127.0.0.1 已在代码里默认放行，无需填写。
# 部署到其它地址时必须填这里，否则注册/登录等 POST 请求会被 CORS 拦成 403。
# 多个用逗号分隔，例如：
# CORS_ORIGINS=http://10.0.219.241:17073,https://kaoyan.example.com
CORS_ORIGINS=

# 注册邮箱验证码的投递方式。
# mock（默认）：不真发信，验证码打印到服务端日志
#   docker compose -p kaoyan408 logs api | grep "MOCK MAIL"
# smtp：真实投递，需要补齐下面四项（QQ 邮箱为例）
MAIL_MODE=mock
# SPRING_MAIL_HOST=smtp.qq.com
# SPRING_MAIL_PORT=465
# SPRING_MAIL_USERNAME=you@qq.com
# SPRING_MAIL_PASSWORD=授权码（不是登录密码）
# MAIL_FROM=you@qq.com
# AI 学习助手（Command Code Provider API）。
# 不填则页面仍可打开，只是对话会提示「服务未配置」。
# 该服务是 OpenAI 兼容格式，如果换成别家（智谱/DeepSeek官方等），
# 改 KAOYAN_AI_BASE_URL 即可，无需改代码。
# KAOYAN_AI_API_KEY=your-key-here
# KAOYAN_AI_BASE_URL=https://api.commandcode.ai/provider/v1
# KAOYAN_AI_MODEL=deepseek/deepseek-v4.1-flash

# 内容种子重灌（谨慎）：默认 false。
# 种子文件指纹变化时会自动重灌；这里只在需要「用同一份内容强制重灌」时打开。
# 注意：重灌会 DELETE 题库并重新插入，question.id 变化会让已有作答记录成为孤儿，
# 因此检测到作答数据时 force 会被拒绝，必须同时设置下面第二个开关才执行。
# KAOYAN_SEED_FORCE=false
# KAOYAN_SEED_FORCE_WITH_USER_DATA=false
# JWT 密钥应急开关：默认 false。
# 密钥等于仓库默认值或短于 32 字节时，服务默认拒绝启动（公开密钥等于人人可伪造登录态）。
# 线上紧急恢复时可以临时设为 true：改为告警并继续启动（过短密钥按 SHA-256 派生）。
# 恢复后请立刻换成真正的随机密钥，并把这个开关关掉。
# KAOYAN_AUTH_ALLOW_INSECURE_JWT_SECRET=true
# 内置账号
# 演示账号：公开可登录的展示账号（默认 demo / demo123456），会给它预置一些做题与背诵数据。
# KAOYAN_DEMO_ENABLED=true
# KAOYAN_DEMO_USERNAME=demo
# KAOYAN_DEMO_PASSWORD=demo123456
# KAOYAN_DEMO_SEED_DATA=true
#
# 演示管理员：登录页「演示管理员」入口用它，默认只读（能看后台，不能改数据）。
# 它与真管理员必须是两个账号，用户名不能相同。
# KAOYAN_DEMO_ADMIN_ENABLED=false    # 已合并进 demo 账号，默认关闭
# KAOYAN_DEMO_ADMIN_USERNAME=demo-admin
# KAOYAN_DEMO_ADMIN_PASSWORD=demo-admin123456
# KAOYAN_DEMO_ADMIN_READONLY=true
#
# 管理员账号：用户名留空则不创建。密码只从这里来，**不要**写进仓库或 compose。
# 第一次部署时设置一次即可，之后账号会保留；忘记密码时把 RESET 置 true 重启一次。
# KAOYAN_ADMIN_USERNAME=admin
# KAOYAN_ADMIN_PASSWORD=换成你的强密码
# KAOYAN_ADMIN_RESET_PASSWORD=false