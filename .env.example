# 复制为 .env 后按需修改；.env 不入库
# 数据库密码（同时作为 MySQL 容器 root 密码与 kaoyan 用户密码）
DB_PASSWORD=change-me-db-password

# JWT 签名密钥，生产环境必须替换为随机长字符串（HS256 要求至少 32 字节）
JWT_SECRET=change-me-jwt-secret-at-least-32-bytes

# 对外访问端口（nginx）。默认 18080，避免与本机开发用的 8080 冲突。
WEB_PORT=18080

# 数据库映射到宿主机的端口，仅用于排查；默认 33061 避开本机 3306
DB_PORT=33061

# 允许跨域访问 API 的来源（浏览器地址）。
# 本地开发用的 localhost / 127.0.0.1 已在代码里默认放行，无需填写。
# 部署到其它地址时必须填这里，否则注册/登录等 POST 请求会被 CORS 拦成 403。
# 多个用逗号分隔，例如：
# CORS_ORIGINS=http://10.0.219.241:17073,https://kaoyan.example.com
CORS_ORIGINS=

# 注册邮箱验证码的投递方式。
# mock（默认）：不真发信，验证码打印到服务端日志
#   docker compose -p kaoyan408 logs api | grep "MOCK MAIL"
# smtp：真实投递，需要补齐下面四项（QQ 邮箱为例）
MAIL_MODE=mock
# SPRING_MAIL_HOST=smtp.qq.com
# SPRING_MAIL_PORT=465
# SPRING_MAIL_USERNAME=you@qq.com
# SPRING_MAIL_PASSWORD=授权码（不是登录密码）
# MAIL_FROM=you@qq.com
# AI 学习助手（Command Code Provider API）。
# 不填则页面仍可打开，只是对话会提示「服务未配置」。
# 该服务是 OpenAI 兼容格式，如果换成别家（智谱/DeepSeek官方等），
# 改 KAOYAN_AI_BASE_URL 即可，无需改代码。
# KAOYAN_AI_API_KEY=your-key-here
# KAOYAN_AI_BASE_URL=https://api.commandcode.ai/provider/v1
# KAOYAN_AI_MODEL=deepseek/deepseek-v4.1-flash
