# 复制为 .env 后按需修改；.env 不入库
# 数据库密码（同时作为 MySQL 容器 root 密码与 kaoyan 用户密码）
DB_PASSWORD=change-me-db-password

# JWT 签名密钥，生产环境必须替换为随机长字符串（HS256 要求至少 32 字节）
JWT_SECRET=change-me-jwt-secret-at-least-32-bytes

# 对外访问端口（nginx）。默认 18080，避免与本机开发用的 8080 冲突。
WEB_PORT=18080

# 数据库映射到宿主机的端口，仅用于排查；默认 33061 避开本机 3306
DB_PORT=33061